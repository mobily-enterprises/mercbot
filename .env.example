DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=account_app
DB_USER=account_app
DB_PASSWORD=replace-me
AUTH_LOCAL_SESSION_SECRET=replace-with-a-long-random-secret
PORT=3001
APP_PUBLIC_URL=http://localhost:3001
# Mercbot's three kinds of AI (D-72), each with its provider and key. Mercbot doesn't start without the premium and
# economy ones; images is optional, and without it bots say pictures aren't set up and the Vault reads no photos.
AI_PREMIUM_PROVIDER=together
AI_PREMIUM_API_KEY=replace-with-a-together-ai-key
AI_ECONOMY_PROVIDER=deepinfra
AI_ECONOMY_API_KEY=replace-with-a-deepinfra-key
AI_IMAGES_PROVIDER=gemini
AI_IMAGES_API_KEY=replace-with-a-gemini-key
