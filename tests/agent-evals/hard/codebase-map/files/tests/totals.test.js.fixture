const test = require("node:test");
const assert = require("node:assert/strict");
const { computeTotals } = require("../src/billing/totals");

test("GST on a line, no discount", () => {
  const totals = computeTotals([{ description: "Work", quantity: 2, unitPrice: 50, taxCode: "GST" }], { tax_exempt: false });
  assert.deepEqual([totals.subtotal, totals.tax, totals.total], [10000, 1000, 11000]);
});

test("tax-exempt customers pay no tax", () => {
  assert.equal(computeTotals([{ description: "Work", quantity: 1, unitPrice: 10, taxCode: "GST" }], { tax_exempt: true }).tax, 0);
});
