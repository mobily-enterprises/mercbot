import unittest
from calc import run, CalcError


class Arithmetic(unittest.TestCase):
    def test_numbers(self):
        self.assertEqual(run("42"), 42)
        self.assertEqual(run("3.5"), 3.5)

    def test_precedence(self):
        self.assertEqual(run("1 + 2 * 3"), 7)
        self.assertEqual(run("(1 + 2) * 3"), 9)
        self.assertEqual(run("10 - 4 - 3"), 3)
        self.assertEqual(run("16 / 4 / 2"), 2)

    def test_power(self):
        self.assertEqual(run("2^3^2"), 512)
        self.assertEqual(run("-2^2"), -4)
        self.assertEqual(run("(-2)^2"), 4)

    def test_unary(self):
        self.assertEqual(run("--3"), 3)
        self.assertEqual(run("2 * -3"), -6)

    def test_whole_results_are_ints(self):
        self.assertIsInstance(run("7 / 7"), int)
        self.assertEqual(run("7 / 2"), 3.5)


class Variables(unittest.TestCase):
    def test_let(self):
        self.assertEqual(run("let x = 4"), 4)
        self.assertEqual(run("let x = 4; x * x"), 16)

    def test_newlines(self):
        self.assertEqual(run("let a = 2\nlet b = a + 1\na * b"), 6)

    def test_names(self):
        self.assertEqual(run("let rate_2 = 3; rate_2 + 1"), 4)

    def test_unknown(self):
        with self.assertRaises(CalcError) as caught:
            run("y + 1")
        self.assertEqual(str(caught.exception), "unknown variable: y")


class Functions(unittest.TestCase):
    def test_min_max(self):
        self.assertEqual(run("min(3, 1, 2)"), 1)
        self.assertEqual(run("max(3, 1 + 5, 2)"), 6)

    def test_sqrt_abs(self):
        self.assertEqual(run("sqrt(16)"), 4)
        self.assertEqual(run("abs(-2.5)"), 2.5)

    def test_unknown_function(self):
        with self.assertRaises(CalcError) as caught:
            run("foo(1)")
        self.assertEqual(str(caught.exception), "unknown function: foo")

    def test_sqrt_negative(self):
        with self.assertRaises(CalcError) as caught:
            run("sqrt(-1)")
        self.assertEqual(str(caught.exception), "sqrt of negative number")


class Errors(unittest.TestCase):
    def test_division_by_zero(self):
        with self.assertRaises(CalcError) as caught:
            run("1 / (2 - 2)")
        self.assertEqual(str(caught.exception), "division by zero")

    def test_syntax_unexpected_character(self):
        with self.assertRaises(CalcError) as caught:
            run("1 + $")
        self.assertEqual(str(caught.exception), "syntax error at position 4")

    def test_syntax_end_of_input(self):
        with self.assertRaises(CalcError) as caught:
            run("(1 + 2")
        self.assertEqual(str(caught.exception), "syntax error at position 6")

    def test_syntax_two_numbers(self):
        with self.assertRaises(CalcError) as caught:
            run("1 2")
        self.assertEqual(str(caught.exception), "syntax error at position 2")


if __name__ == "__main__":
    unittest.main()
