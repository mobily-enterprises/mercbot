{
  "name": "account-app",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "JSKIT account app with local authentication and PostgreSQL persistence",
  "engines": {
    "node": "26.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "server": "bash ./scripts/serve.sh",
    "server:all": "bash ./scripts/serve.sh",
    "server:home": "SERVER_SURFACE=home bash ./scripts/serve.sh",
    "start": "bash ./scripts/serve.sh",
    "develop": "bash ./scripts/namespace.sh node ./bin/develop.js",
    "dev": "vite",
    "dev:all": "vite",
    "dev:home": "VITE_SURFACE=home vite",
    "build": "vite build",
    "build:all": "vite build",
    "build:home": "VITE_SURFACE=home vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "jskit test --import=./tests/support/testFile.mjs --test-global-setup=./tests/support/unitRun.mjs tests/server/*.test.js",
    "test:client": "vitest run tests/client",
    "test:e2e": "playwright test tests/e2e",
    "db:prepare": "node ./scripts/prepare-database.js",
    "tools:install": "bash ./scripts/install-tools.sh",
    "files:mount": "bash ./scripts/mount-files.sh",
    "deploy:prepare": "npm ci --include=dev && MERCBOT_TOOLS_STORE=\"${MERCBOT_TOOLS_STORE:-$HOME/.cache/mercbot-tools}\" npm run tools:install",
    "db:migrate": "knex --knexfile ./knexfile.js migrate:latest",
    "db:migrate:rollback": "knex --knexfile ./knexfile.js migrate:rollback",
    "db:migrate:status": "knex --knexfile ./knexfile.js migrate:list",
    "jskit:update": "npx --yes @jskit-ai/jskit-catalog@latest update",
    "jskit:check": "jskit check",
    "verify": "npm run jskit:check && npm run lint && npm run test && npm run test:client && npm run build",
    "test:database": "jskit test --import=./tests/support/testFile.mjs --test-global-setup=./tests/support/databaseRun.mjs tests/server/*.integration.js tests/server/characterization/*.integration.js",
    "postinstall": "patch-package",
    "bench": "jskit test tests/bench/*.bench.js",
    "check:templates": "node ./scripts/check-templates.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.93",
    "@ai-sdk/deepseek": "3.0.72",
    "@browserbasehq/stagehand": "4.3.0",
    "@fastify/fast-json-stringify-compiler": "^5.1.0",
    "@fastify/static": "^10.1.4",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@jskit-ai/agent": "0.1.3",
    "@jskit-ai/agent-runtime": "0.1.20",
    "@jskit-ai/auth-core": "0.2.21",
    "@jskit-ai/auth-provider-local-core": "0.2.25",
    "@jskit-ai/auth-provider-local-db-core": "0.1.174",
    "@jskit-ai/auth-web": "0.2.33",
    "@jskit-ai/database-runtime-postgres": "0.1.267",
    "@jskit-ai/http-runtime": "0.2.21",
    "@jskit-ai/http-web": "0.2.36",
    "@jskit-ai/kernel": "0.2.21",
    "@jskit-ai/material-web": "0.1.6",
    "@jskit-ai/shell-web": "0.2.30",
    "@jskit-ai/users-web": "0.2.47",
    "@jskit-ai/workspaces-core": "0.2.35",
    "@jskit-ai/workspaces-web": "0.2.47",
    "@local/account": "0.1.0",
    "@local/apps": "0.1.0",
    "@local/bots": "0.1.0",
    "@local/computer": "0.1.0",
    "@local/files": "0.1.0",
    "@local/homes": "0.1.0",
    "@local/integrations": "0.1.0",
    "@local/main": "0.1.0",
    "@local/notices": "0.1.0",
    "@local/single-user": "0.1.0",
    "@local/websites": "0.1.0",
    "@novnc/novnc": "1.7.0",
    "@tanstack/vue-query": "^5.103.1",
    "@vue/devtools-api": "^8.2.1",
    "ai": "7.0.152",
    "chart.js": "4.6.1",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "fastify": "^5.12.5",
    "json-rest-schema": "^1.0.17",
    "markdown-it": "15.0.3",
    "parse5": "8.1.1",
    "patch-package": "8.0.1",
    "pinia": "^4.0.3",
    "pino": "^10.3.1",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.6",
    "puppeteer-core": "25.16.0",
    "quickjs-emscripten-core": "0.32.0",
    "read-excel-file": "9.3.13",
    "vue": "^3.5.43",
    "vue-chartjs": "5.3.4",
    "vue-router": "^5.3.1",
    "vuetify": "^4.3.0",
    "write-excel-file": "4.1.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jskit-ai/config-eslint": "0.1.251",
    "@jskit-ai/jskit-catalog": "0.2.68",
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "knex": "^3.3.0",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true,
    "@jskit-ai/material-web": true
  }
}
