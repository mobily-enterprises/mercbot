{
  "name": "@local/bots",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Bots, their conversations, scripted onboarding and DeepSeek replies (D-8).",
  "exports": {
    "./server/types": "./src/server/types.js",
    "./server/botRows": "./src/server/botRows.js",
    "./server/records/directory": "./src/server/records/directory.js",
    "./server/templates": "./src/server/templates.js"
  },
  "dependencies": {
    "@jskit-ai/agent": "0.1.3",
    "@jskit-ai/agent-runtime": "0.1.26",
    "@jskit-ai/database-runtime": "0.1.275",
    "@jskit-ai/kernel": "0.2.26",
    "@jskit-ai/resource-core": "0.1.217",
    "@jskit-ai/resource-runtime": "0.2.34",
    "@local/account": "0.1.0",
    "@local/apps": "0.1.0",
    "@local/files": "0.1.0",
    "@local/homes": "0.1.0",
    "croner": "10.0.1",
    "tldts": "7.4.22",
    "zod": "4.6.7"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "mercbot.bots",
        "mercbot.bot-loops",
        "mercbot.bots.records"
      ],
      "requires": [
        "runtime.http",
        "runtime.fastify",
        "mercbot.computer",
        "mercbot.notices",
        "mercbot.integrations",
        "mercbot.files",
        "mercbot.apps",
        "mercbot.meter",
        "mercbot.account",
        "runtime.env",
        "runtime.resources",
        "users.profiles",
        "workspaces",
        "workspaces.memberships"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/records/BotRecordsFeature.js",
            "export": "BotRecordsFeature"
          },
          {
            "entrypoint": "src/server/BotsFeature.js",
            "export": "BotsFeature"
          }
        ]
      },
      "client": {
        "providers": []
      }
    }
  }
}
