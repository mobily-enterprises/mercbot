{
  "name": "@local/integrations",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Connect apps: the plugin catalogue, installs and accounts, and private skills.",
  "exports": {
    "./server/types": "./src/server/types.js"
  },
  "dependencies": {
    "@jskit-ai/database-runtime": "0.1.270",
    "@jskit-ai/kernel": "0.2.21",
    "@jskit-ai/resource-core": "0.1.212",
    "@jskit-ai/resource-runtime": "0.2.28",
    "@local/account": "0.1.0",
    "@local/homes": "0.1.0",
    "oauth4webapi": "^3.8.8",
    "simple-icons": "^16.36.0"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "mercbot.integrations"
      ],
      "requires": [
        "runtime.http",
        "runtime.env",
        "runtime.resources",
        "users.profiles",
        "workspaces.memberships",
        "mercbot.apps"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/IntegrationsFeature.js",
            "export": "IntegrationsFeature"
          }
        ]
      },
      "client": {
        "providers": []
      }
    }
  }
}
