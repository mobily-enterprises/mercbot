{
  "key": "meal_planner",
  "name": "Meal planner and shopping list",
  "icon": "calendar",
  "glyph": "restaurant",
  "color": "#C24A0C",
  "audiences": [
    "family",
    "personal"
  ],
  "description": "Plan the week's meals on a calendar; what each needs goes onto the home's one shopping list, ticked off in the shop.",
  "tables": [
    {
      "key": "meals",
      "fields": [
        {
          "key": "dish",
          "type": "text",
          "required": true
        },
        {
          "key": "day",
          "type": "date",
          "required": true
        },
        {
          "key": "meal",
          "type": "choice",
          "choices": [
            "Breakfast",
            "Lunch",
            "Dinner",
            "Snack"
          ]
        },
        {
          "key": "cook",
          "type": "text",
          "label": "Who cooks"
        },
        {
          "key": "recipe",
          "type": "url"
        },
        {
          "key": "notes",
          "type": "text"
        }
      ]
    },
    {
      "key": "list_items",
      "fields": [
        {
          "key": "meal",
          "type": "link",
          "label": "For meal",
          "target": "meals"
        }
      ]
    }
  ],
  "definition": {
    "home": "week",
    "navigation": {
      "style": "tabs",
      "items": [
        {
          "screen": "week",
          "label": "This week",
          "icon": "calendar"
        },
        {
          "screen": "shopping",
          "label": "Shopping list",
          "icon": "check"
        },
        {
          "screen": "meals",
          "label": "Meals",
          "icon": "search"
        }
      ]
    },
    "screens": {
      "week": {
        "data": {
          "soon": {
            "from": "meals",
            "where": "=day >= addDays(today(), -7)",
            "sort": "day"
          }
        },
        "content": [
          {
            "type": "row",
            "content": [
              {
                "type": "text",
                "value": "Drag a meal to another day to swap it.",
                "size": "body"
              },
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "Plan a meal",
                "emphasis": "primary",
                "icon": "add",
                "do": [
                  {
                    "go": {
                      "screen": "new_meal"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "calendar",
            "rows": "=data.soon",
            "date": "day",
            "title": "=row.dish",
            "subtitle": "=row.meal",
            "span": "week",
            "onClick": [
              {
                "go": {
                  "screen": "meal",
                  "params": {
                    "id": "=row.id"
                  }
                }
              }
            ]
          }
        ]
      },
      "shopping": {
        "data": {
          "toGet": {
            "from": "list_items",
            "where": "=kind == \"shopping\" && done != true",
            "sort": "group"
          }
        },
        "content": [
          {
            "type": "form",
            "table": "list_items",
            "fields": [
              {
                "field": "title",
                "label": "Item"
              },
              {
                "field": "quantity",
                "label": "How many"
              },
              "unit",
              {
                "field": "group",
                "label": "Aisle"
              }
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Add to the list",
                "emphasis": "primary",
                "icon": "add",
                "disabled": "=!form.valid",
                "do": [
                  {
                    "create": {
                      "table": "list_items",
                      "values": "=form.values",
                      "preset": {
                        "kind": "shopping",
                        "done": false
                      }
                    }
                  },
                  {
                    "notify": "=\"Added.\""
                  }
                ]
              }
            ]
          },
          {
            "type": "table",
            "rows": "=data.toGet",
            "columns": [
              {
                "label": "Item",
                "value": "=row.title"
              },
              {
                "label": "How many",
                "value": "=row.quantity"
              },
              {
                "label": "Unit",
                "value": "=row.unit"
              },
              {
                "label": "Aisle",
                "value": "=row.group"
              },
              {
                "label": "For",
                "value": "=row.meal"
              }
            ],
            "rowActions": [
              {
                "type": "button",
                "label": "Got it",
                "emphasis": "subtle",
                "icon": "check",
                "do": [
                  {
                    "update": {
                      "record": "=row",
                      "set": {
                        "done": "=true"
                      }
                    }
                  },
                  {
                    "notify": "=\"Done.\""
                  }
                ]
              }
            ]
          }
        ]
      },
      "meals": {
        "data": {
          "all": {
            "from": "meals",
            "sort": "-day"
          }
        },
        "content": [
          {
            "type": "row",
            "content": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "New meal",
                "emphasis": "primary",
                "icon": "add",
                "do": [
                  {
                    "go": {
                      "screen": "new_meal"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "table",
            "rows": "=data.all",
            "columns": [
              {
                "label": "Day",
                "value": "=row.day"
              },
              {
                "label": "Meal",
                "value": "=row.meal"
              },
              {
                "label": "Dish",
                "value": "=row.dish"
              },
              {
                "label": "Who cooks",
                "value": "=row.cook"
              }
            ],
            "search": "Find a dish",
            "onRowClick": [
              {
                "go": {
                  "screen": "meal",
                  "params": {
                    "id": "=row.id"
                  }
                }
              }
            ]
          }
        ]
      },
      "meal": {
        "params": {
          "id": {
            "type": "string"
          }
        },
        "data": {
          "item": {
            "record": "meals",
            "id": "=params.id"
          }
        },
        "content": [
          {
            "type": "form",
            "record": "=data.item",
            "fields": [
              "dish",
              "day",
              "meal",
              "cook",
              "recipe",
              "notes"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Save",
                "emphasis": "primary",
                "icon": "save",
                "disabled": "=!form.valid || !form.changed",
                "do": [
                  {
                    "update": {
                      "record": "=data.item",
                      "set": "=form.values"
                    }
                  },
                  {
                    "notify": "=\"Saved.\""
                  },
                  {
                    "go": {
                      "screen": "meals"
                    }
                  }
                ]
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "meals"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "lines",
            "label": "What to buy for it",
            "record": "=data.item",
            "table": "list_items",
            "link": "meal",
            "columns": [
              {
                "label": "Item",
                "value": "=row.title"
              },
              {
                "label": "How many",
                "value": "=row.quantity"
              },
              {
                "label": "Aisle",
                "value": "=row.group"
              },
              {
                "label": "Got it",
                "value": "=row.done"
              }
            ],
            "fields": [
              {
                "field": "title",
                "label": "Item"
              },
              {
                "field": "quantity",
                "label": "How many"
              },
              "unit",
              {
                "field": "group",
                "label": "Aisle"
              },
              {
                "field": "done",
                "label": "Got it"
              }
            ],
            "preset": {
              "kind": "shopping",
              "done": false
            }
          },
          {
            "type": "row",
            "content": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "Remove",
                "icon": "close",
                "emphasis": "subtle",
                "confirm": "Remove this meal? It can be brought back from the Data tab.",
                "do": [
                  {
                    "markObsolete": {
                      "record": "=data.item"
                    }
                  },
                  {
                    "notify": "=\"Removed.\""
                  },
                  {
                    "go": {
                      "screen": "meals"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "new_meal": {
        "content": [
          {
            "type": "form",
            "table": "meals",
            "fields": [
              "dish",
              "day",
              "meal",
              "cook",
              "recipe",
              "notes"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Add",
                "emphasis": "primary",
                "icon": "add",
                "disabled": "=!form.valid",
                "do": [
                  {
                    "create": {
                      "table": "meals",
                      "values": "=form.values"
                    }
                  },
                  {
                    "notify": "=\"Added.\""
                  },
                  {
                    "go": {
                      "screen": "week"
                    }
                  }
                ]
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "meals"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "sample": {
    "meals": [
      {
        "dish": "Vegetable lasagne",
        "day": "2026-11-30",
        "meal": "Dinner",
        "cook": "Dad"
      },
      {
        "dish": "Pancakes",
        "day": "2026-11-29",
        "meal": "Breakfast",
        "cook": "Maya"
      },
      {
        "dish": "Chicken tacos",
        "day": "2026-12-01",
        "meal": "Dinner",
        "cook": "Mum",
        "recipe": "https://example.com/tacos"
      }
    ],
    "list_items": [
      {
        "kind": "shopping",
        "title": "Lasagne sheets",
        "quantity": 1.0,
        "unit": "box",
        "group": "Cupboard",
        "done": false,
        "meal": {
          "sample": "meals",
          "dish": "Vegetable lasagne"
        }
      },
      {
        "kind": "shopping",
        "title": "Courgettes",
        "quantity": 2.0,
        "group": "Fruit and veg",
        "done": false,
        "meal": {
          "sample": "meals",
          "dish": "Vegetable lasagne"
        }
      },
      {
        "kind": "shopping",
        "title": "Eggs",
        "quantity": 6.0,
        "group": "Dairy and eggs",
        "done": false,
        "meal": {
          "sample": "meals",
          "dish": "Pancakes"
        }
      },
      {
        "kind": "shopping",
        "title": "Washing-up liquid",
        "group": "Household",
        "done": false
      }
    ]
  },
  "uses": [
    "list_items"
  ]
}
