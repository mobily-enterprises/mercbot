            "type": "form",
            "table": "todos",
            "fields": [
              "title",
              "assignee",
              "status",
              "due",
              "notes"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Add",
                "do": [
                  {
                    "create": {
                      "table": "todos",
                      "values": "=form.values",
                      "preset": {
                        "parent": "=params.parent",
                        "status": "=form.status == \"\" ? \"To do\" : form.status"
                      }
                    }
                  },
                  {
                    "notify": "=\"Added \" + form.title"
                  },
                  {
                    "go": {
                      "screen": "task",
                      "params": {
                        "id": "=params.parent"
                      }
                    }
                  }
                ],
                "emphasis": "primary"
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "task",
                      "params": {
                        "id": "=params.parent"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "new_list": {
        "content": [
          {
            "type": "form",
            "table": "todo_lists",
            "fields": [
              "name",
              "owner",
              "colour"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Add",
                "do": [
                  {
                    "create": {
                      "table": "todo_lists",
                      "values": "=form.values"
                    }
                  },
                  {
                    "notify": "=\"Added \" + form.name"
                  },
                  {
                    "go": {
                      "screen": "lists"
                    }
                  }
                ],
                "emphasis": "primary"
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "lists"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "new_department": {
        "content": [
          {
            "type": "form",
            "table": "departments",
            "fields": [
              "name",
