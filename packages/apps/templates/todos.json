                      "preset": {
                        "todo_list": "=params.todo_list",
                        "status": "=form.status == \"\" ? \"To do\" : form.status"
                      }
                    }
                  },
                  {
                    "notify": "=\"Added \" + form.title"
                  },
                  {
                    "go": {
                      "screen": "todo_list",
                      "params": {
                        "id": "=params.todo_list"
                      }
                    }
                  }
                ],
                "emphasis": "primary"
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "todo_list",
                      "params": {
                        "id": "=params.todo_list"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "new_subtask": {
        "params": {
