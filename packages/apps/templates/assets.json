{
  "key": "assets",
  "name": "Asset register",
  "icon": "check",
  "glyph": "devices",
  "color": "#4A5B68",
  "audiences": [
    "corporate",
    "business"
  ],
  "description": "Laptops, phones, furniture and tools: who has each one, where it is and when its warranty ends.",
  "uses": [
    "places"
  ],
  "tables": [
    {
      "key": "assets",
      "fields": [
        {
          "key": "name",
          "type": "text",
          "required": true
        },
        {
          "key": "asset_tag",
          "type": "text",
          "unique": true,
          "label": "Asset tag"
        },
        {
          "key": "kind",
          "type": "choice",
          "choices": [
            "Laptop",
            "Phone",
            "Monitor",
            "Furniture",
            "Vehicle",
            "Tool",
            "Other"
          ]
        },
        {
          "key": "serial",
          "type": "text",
          "unique": true,
          "label": "Serial number"
        },
        {
          "key": "assigned_to",
          "type": "person"
        },
        {
          "key": "location",
          "type": "link",
          "target": "places"
        },
        {
          "key": "status",
          "type": "choice",
          "choices": [
            "In use",
            "In storage",
            "Being repaired",
            "Retired"
          ]
        },
        {
          "key": "bought",
          "type": "date"
        },
        {
          "key": "cost",
          "type": "money",
          "min": 0
        },
        {
          "key": "warranty_until",
          "type": "date"
        },
        {
          "key": "under_warranty",
          "type": "yesno",
          "formula": "=warranty_until != \"\" && warranty_until >= today()"
        },
        {
          "key": "photo",
          "type": "image"
        },
        {
          "key": "notes",
          "type": "longtext"
        }
      ]
    }
  ],
  "definition": {
    "home": "assets",
    "navigation": {
      "style": "tabs",
      "items": [
        {
          "screen": "assets",
          "label": "Assets",
          "icon": "check"
        },
        {
          "screen": "warranty",
          "label": "Warranty ending",
          "icon": "calendar"
        },
        {
          "screen": "summary",
          "label": "Summary",
          "icon": "chart"
        }
      ]
    },
    "screens": {
      "assets": {
        "data": {
          "all": {
            "from": "assets",
            "sort": "name"
          }
        },
        "content": [
          {
            "type": "row",
            "content": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "New asset",
                "emphasis": "primary",
                "icon": "add",
                "do": [
                  {
                    "go": {
                      "screen": "new_asset"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "table",
            "rows": "=data.all",
            "columns": [
              {
                "label": "Asset",
                "value": "=row.name"
              },
              {
                "label": "Tag",
                "value": "=row.asset_tag"
              },
              {
                "label": "Kind",
                "value": "=row.kind"
              },
              {
                "label": "With",
                "value": "=row.assigned_to"
              },
              {
                "label": "Where",
                "value": "=row.location"
              },
              {
                "label": "Status",
                "value": "=row.status",
                "display": "chip"
              }
            ],
            "search": "Find an asset",
            "onRowClick": [
              {
                "go": {
                  "screen": "asset",
                  "params": {
                    "id": "=row.id"
                  }
                }
              }
            ]
          }
        ]
      },
      "asset": {
        "params": {
          "id": {
            "type": "string"
          }
        },
        "data": {
          "item": {
            "record": "assets",
            "id": "=params.id"
          }
        },
        "content": [
          {
            "type": "form",
            "record": "=data.item",
            "fields": [
              "name",
              "asset_tag",
              "kind",
              "serial",
              "assigned_to",
              "location",
              "status",
              "bought",
              "cost",
              "warranty_until",
              "under_warranty",
              "photo",
              "notes"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Save",
                "emphasis": "primary",
                "icon": "save",
                "disabled": "=!form.valid || !form.changed",
                "do": [
                  {
                    "update": {
                      "record": "=data.item",
                      "set": "=form.values"
                    }
                  },
                  {
                    "notify": "=\"Saved.\""
                  },
                  {
                    "go": {
                      "screen": "assets"
                    }
                  }
                ]
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "assets"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "row",
            "content": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "Remove",
                "icon": "close",
                "emphasis": "subtle",
                "confirm": "Remove this asset? It can be brought back from the Data tab.",
                "do": [
                  {
                    "markObsolete": {
                      "record": "=data.item"
                    }
                  },
                  {
                    "notify": "=\"Removed.\""
                  },
                  {
                    "go": {
                      "screen": "assets"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "new_asset": {
        "content": [
          {
            "type": "form",
            "table": "assets",
            "fields": [
              "name",
              "asset_tag",
              "kind",
              "serial",
              "assigned_to",
              "location",
              "bought",
              "cost",
              "warranty_until",
              "photo",
              "notes"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Add",
                "emphasis": "primary",
                "icon": "add",
                "disabled": "=!form.valid",
                "do": [
                  {
                    "create": {
                      "table": "assets",
                      "values": "=form.values",
                      "preset": {
                        "status": "In use"
                      }
                    }
                  },
                  {
                    "notify": "=\"Added.\""
                  },
                  {
                    "go": {
                      "screen": "assets"
                    }
                  }
                ]
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "assets"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "warranty": {
        "data": {
          "soon": {
            "from": "assets",
            "where": "=warranty_until >= today() && warranty_until <= addDays(today(), 90)",
            "sort": "warranty_until"
          }
        },
        "content": [
          {
            "type": "text",
            "value": "Assets whose warranty ends in the next 90 days.",
            "size": "body"
          },
          {
            "type": "table",
            "rows": "=data.soon",
            "columns": [
              {
                "label": "Asset",
                "value": "=row.name"
              },
              {
                "label": "Kind",
                "value": "=row.kind"
              },
              {
                "label": "With",
                "value": "=row.assigned_to"
              },
              {
                "label": "Warranty until",
                "value": "=row.warranty_until"
              }
            ],
            "onRowClick": [
              {
                "go": {
                  "screen": "asset",
                  "params": {
                    "id": "=row.id"
                  }
                }
              }
            ]
          }
        ]
      },
      "summary": {
        "data": {
          "byKind": {
            "from": "assets",
            "groupBy": "kind"
          },
          "value": {
            "from": "assets",
            "groupBy": "status",
            "sum": "cost",
            "grandTotal": true
          }
        },
        "content": [
          {
            "type": "grid",
            "columns": 2,
            "content": [
              {
                "type": "chart",
                "kind": "pie",
                "label": "Assets by kind",
                "rows": "=data.byKind"
              },
              {
                "type": "chart",
                "kind": "bar",
                "label": "Value by status",
                "rows": "=data.value",
                "measure": "total"
              }
            ]
          },
          {
            "type": "totals",
            "label": "What they cost, by status",
            "rows": "=data.value"
          }
        ]
      }
    }
  },
  "sample": {
    "assets": [
      {
        "name": "MacBook Pro 14",
        "asset_tag": "IT-0042",
        "kind": "Laptop",
        "serial": "C02FX1Z9MD6T",
        "status": "In use",
        "bought": "2025-03-14",
        "cost": 239900,
        "warranty_until": "2027-03-14"
      },
      {
        "name": "Standing desk",
        "asset_tag": "FUR-0107",
        "kind": "Furniture",
        "status": "In use",
        "bought": "2024-09-02",
        "cost": 54900
      },
      {
        "name": "Pixel 8",
        "asset_tag": "IT-0051",
        "kind": "Phone",
        "serial": "38041FDJH00A7Q",
        "status": "In storage",
        "bought": "2024-12-10",
        "cost": 69900,
        "warranty_until": "2026-12-10"
      }
    ]
  }
}
