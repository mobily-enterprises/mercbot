{
  "key": "memberships",
  "name": "Members and renewals",
  "icon": "person",
  "glyph": "cardMembership",
  "color": "#3F4FB8",
  "audiences": [
    "business"
  ],
  "description": "Your members, their plans and renewal dates; see who renews this month and renew them in one press.",
  "tables": [
    {
      "key": "members",
      "fields": [
        {
          "key": "name",
          "type": "text",
          "required": true
        },
        {
          "key": "email",
          "type": "email",
          "unique": true
        },
        {
          "key": "phone",
          "type": "phone"
        },
        {
          "key": "plan",
          "type": "choice",
          "choices": [
            "Monthly",
            "Yearly",
            "Student",
            "Life"
          ]
        },
        {
          "key": "joined",
          "type": "date"
        },
        {
          "key": "renews",
          "type": "date"
        },
        {
          "key": "status",
          "type": "choice",
          "choices": [
            "Active",
            "Lapsed",
            "Cancelled"
          ]
        },
        {
          "key": "renews_soon",
          "type": "yesno",
          "formula": "=renews != \"\" && renews <= addDays(today(), 30)"
        },
        {
          "key": "member_number",
          "type": "text",
          "unique": true,
          "pattern": "M-[0-9]{4,6}",
          "patternMessage": "M- and four to six digits, e.g. M-0042"
        },
        {
          "key": "notes",
          "type": "longtext"
        }
      ]
    }
  ],
  "definition": {
    "home": "members",
    "navigation": {
      "style": "tabs",
      "items": [
        {
          "screen": "members",
          "label": "Members",
          "icon": "person"
        },
        {
          "screen": "renewing",
          "label": "Renewing",
          "icon": "calendar"
        },
        {
          "screen": "summary",
          "label": "Summary",
          "icon": "chart"
        }
      ]
    },
    "screens": {
      "members": {
        "data": {
          "all": {
            "from": "members",
            "sort": "name"
          }
        },
        "content": [
          {
            "type": "row",
            "content": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "New member",
                "emphasis": "primary",
                "icon": "add",
                "do": [
                  {
                    "go": {
                      "screen": "new_member"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "table",
            "rows": "=data.all",
            "columns": [
              {
                "label": "Name",
                "value": "=row.name"
              },
              {
                "label": "Number",
                "value": "=row.member_number"
              },
              {
                "label": "Plan",
                "value": "=row.plan"
              },
              {
                "label": "Renews",
                "value": "=row.renews"
              },
              {
                "label": "Status",
                "value": "=row.status",
                "display": "chip"
              },
              {
                "label": "Renews soon",
                "value": "=row.renews_soon"
              }
            ],
            "search": "Find a member",
            "onRowClick": [
              {
                "go": {
                  "screen": "member",
                  "params": {
                    "id": "=row.id"
                  }
                }
              }
            ]
          }
        ]
      },
      "member": {
        "params": {
          "id": {
            "type": "string"
          }
        },
        "data": {
          "item": {
            "record": "members",
            "id": "=params.id"
          }
        },
        "content": [
          {
            "type": "form",
            "record": "=data.item",
            "fields": [
              "name",
              "member_number",
              "email",
              "phone",
              "plan",
              "joined",
              "renews",
              "status",
              "renews_soon",
              "notes"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Save",
                "emphasis": "primary",
                "icon": "save",
                "disabled": "=!form.valid || !form.changed",
                "do": [
                  {
                    "update": {
                      "record": "=data.item",
                      "set": "=form.values"
                    }
                  },
                  {
                    "notify": "=\"Saved.\""
                  },
                  {
                    "go": {
                      "screen": "members"
                    }
                  }
                ]
              },
              {
                "type": "button",
                "label": "Renewed for a year",
                "icon": "check",
                "confirm": "Renew this membership for a year?",
                "do": [
                  {
                    "update": {
                      "record": "=data.item",
                      "set": {
                        "renews": "=addMonths(data.item.renews == \"\" ? today() : data.item.renews, 12)",
                        "status": "Active"
                      }
                    }
                  },
                  {
                    "notify": "=\"Renewed for a year.\""
                  }
                ]
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "members"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "row",
            "content": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "Remove",
                "icon": "close",
                "emphasis": "subtle",
                "confirm": "Remove this member? It can be brought back from the Data tab.",
                "do": [
                  {
                    "markObsolete": {
                      "record": "=data.item"
                    }
                  },
                  {
                    "notify": "=\"Removed.\""
                  },
                  {
                    "go": {
                      "screen": "members"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "new_member": {
        "content": [
          {
            "type": "form",
            "table": "members",
            "fields": [
              "name",
              "member_number",
              "email",
              "phone",
              "plan",
              "joined",
              "renews",
              "notes"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Add",
                "emphasis": "primary",
                "icon": "add",
                "disabled": "=!form.valid",
                "do": [
                  {
                    "create": {
                      "table": "members",
                      "values": "=form.values",
                      "preset": {
                        "status": "Active"
                      }
                    }
                  },
                  {
                    "notify": "=\"Added.\""
                  },
                  {
                    "go": {
                      "screen": "members"
                    }
                  }
                ]
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "members"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "renewing": {
        "data": {
          "soon": {
            "from": "members",
            "where": "=status == \"Active\" && renews >= addDays(today(), -30) && renews <= addDays(today(), 30)",
            "sort": "renews"
          }
        },
        "content": [
          {
            "type": "text",
            "value": "Renewals from a month ago to a month ahead.",
            "size": "body"
          },
          {
            "type": "table",
            "rows": "=data.soon",
            "columns": [
              {
                "label": "Name",
                "value": "=row.name"
              },
              {
                "label": "Plan",
                "value": "=row.plan"
              },
              {
                "label": "Renews",
                "value": "=row.renews"
              },
              {
                "label": "Email",
                "value": "=row.email"
              }
            ],
            "onRowClick": [
              {
                "go": {
                  "screen": "member",
                  "params": {
                    "id": "=row.id"
                  }
                }
              }
            ],
            "rowActions": [
              {
                "type": "button",
                "label": "Renewed",
                "emphasis": "subtle",
                "icon": "check",
                "confirm": "Renew this membership?",
                "do": [
                  {
                    "update": {
                      "record": "=row",
                      "set": {
                        "renews": "=addMonths(row.renews, row.plan == \"Monthly\" ? 1 : 12)",
                        "status": "Active"
                      }
                    }
                  },
                  {
                    "notify": "=\"Done.\""
                  }
                ]
              }
            ]
          }
        ]
      },
      "summary": {
        "data": {
          "byPlan": {
            "from": "members",
            "where": "=status == \"Active\"",
            "groupBy": "plan"
          },
          "byJoined": {
            "from": "members",
            "groupBy": "joined",
            "by": "month"
          }
        },
        "content": [
          {
            "type": "grid",
            "columns": 2,
            "content": [
              {
                "type": "chart",
                "kind": "pie",
                "label": "Active members by plan",
                "rows": "=data.byPlan"
              },
              {
                "type": "chart",
                "kind": "bar",
                "label": "New members each month",
                "rows": "=data.byJoined"
              }
            ]
          }
        ]
      }
    }
  },
  "sample": {
    "members": [
      {
        "name": "Hannah Ito",
        "email": "hannah@example.com",
        "member_number": "M-0042",
        "plan": "Yearly",
        "joined": "2025-12-05",
        "renews": "2026-12-05",
        "status": "Active"
      },
      {
        "name": "Diego Alves",
        "email": "diego@example.com",
        "member_number": "M-0057",
        "plan": "Monthly",
        "joined": "2026-09-14",
        "renews": "2026-12-14",
        "status": "Active"
      }
    ]
  }
}
