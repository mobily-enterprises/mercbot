{
  "key": "crm",
  "name": "CRM",
  "icon": "person",
  "color": "#1E5BD8",
  "description": "Your pipeline on the home's contacts: each contact's stage, value and next step, and the deals you're working on.",
  "uses": [
    "contacts",
    "organisations",
    "crm_contacts",
    "deals"
  ],
  "tables": [],
  "definition": {
    "home": "pipeline",
    "navigation": {
      "style": "rail",
      "items": [
        {
          "screen": "pipeline",
          "label": "Pipeline",
          "icon": "chart"
        },
        {
          "screen": "contacts",
          "label": "Contacts",
          "icon": "person"
        },
        {
          "screen": "deals",
          "label": "Deals",
          "icon": "star"
        }
      ]
    },
    "screens": {
      "pipeline": {
        "data": {
          "leads": {
            "from": "crm_contacts",
            "sort": "stage"
          },
          "byStage": {
            "from": "crm_contacts",
            "groupBy": "stage",
            "sum": "value"
          }
        },
        "content": [
          {
            "type": "chart",
            "kind": "bar",
            "label": "Pipeline by stage",
            "rows": "=data.byStage",
            "measure": "total"
          },
          {
            "type": "table",
            "rows": "=data.leads",
            "columns": [
              {
                "label": "Contact",
                "value": "=row.contact"
              },
              {
                "label": "Stage",
                "value": "=row.stage",
                "display": "chip"
              },
              {
                "label": "Value",
                "value": "=row.value"
              },
              {
                "label": "Next step",
                "value": "=row.next_step"
              },
              {
                "label": "By",
                "value": "=row.next_step_date"
              }
            ],
            "onRowClick": [
              {
                "go": {
                  "screen": "lead",
                  "params": {
                    "id": "=row.id",
                    "contact": "=row.contact"
                  }
                }
              }
            ]
          }
        ]
      },
      "contacts": {
        "state": {
          "search": {
            "type": "string",
            "default": ""
          }
        },
        "data": {
          "people": {
            "from": "contacts",
            "where": "=state.search == \"\" || name.lowerAscii().contains(state.search.lowerAscii())",
            "sort": "name"
          }
        },
        "content": [
          {
            "type": "row",
            "content": [
              {
                "type": "input",
                "bind": "state.search",
                "label": "Search",
                "icon": "search"
              },
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "New contact",
                "do": [
                  {
                    "go": {
                      "screen": "new_contact"
                    }
                  }
                ],
                "emphasis": "primary"
              }
            ]
          },
          {
            "type": "table",
            "rows": "=data.people",
            "columns": [
              {
                "label": "Name",
                "value": "=row.name"
              },
              {
                "label": "Organisation",
                "value": "=row.organisation"
              },
              {
                "label": "Email",
                "value": "=row.email"
              },
              {
                "label": "Owner",
                "value": "=row.owner"
              }
            ],
            "onRowClick": [
              {
                "go": {
                  "screen": "contact",
                  "params": {
                    "id": "=row.id"
                  }
                }
              }
            ]
          }
        ]
      },
      "contact": {
        "params": {
          "id": {
            "type": "string"
          }
        },
        "data": {
          "person": {
            "record": "contacts",
            "id": "=params.id"
          },
          "pipeline": {
            "from": "crm_contacts",
            "where": "=contact == params.id"
          },
          "deals": {
            "from": "deals",
            "where": "=contact == params.id",
            "sort": "-amount"
          }
        },
        "content": [
          {
            "type": "form",
            "record": "=data.person",
            "fields": [
              "name",
              "email",
              "phone",
              "mobile",
              "organisation",
              "role",
              "tags",
              "owner"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Save",
                "do": [
                  {
                    "update": {
                      "record": "=data.person",
                      "set": "=form.values"
                    }
                  },
                  {
                    "notify": "=\"Saved \" + form.name"
                  }
                ],
                "emphasis": "primary"
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "contacts"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "row",
            "content": [
              {
                "type": "text",
                "value": "In the pipeline",
                "size": "title"
              },
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "Add to the pipeline",
                "do": [
                  {
                    "create": {
                      "table": "crm_contacts",
                      "values": {
                        "contact": "=params.id",
                        "stage": "Lead"
                      }
                    }
                  },
                  {
                    "notify": "Added to the pipeline."
                  }
                ]
              }
            ]
          },
          {
            "type": "table",
            "rows": "=data.pipeline",
            "columns": [
              {
                "label": "Stage",
                "value": "=row.stage",
                "display": "chip"
              },
              {
                "label": "Value",
                "value": "=row.value"
              },
              {
                "label": "Next step",
                "value": "=row.next_step"
              },
              {
                "label": "By",
                "value": "=row.next_step_date"
              }
            ],
            "onRowClick": [
              {
                "go": {
                  "screen": "lead",
                  "params": {
                    "id": "=row.id",
                    "contact": "=params.id"
                  }
                }
              }
            ]
          },
          {
            "type": "text",
            "value": "Deals",
            "size": "title"
          },
          {
            "type": "table",
            "rows": "=data.deals",
            "columns": [
              {
                "label": "Deal",
                "value": "=row.title"
              },
              {
                "label": "Amount",
                "value": "=row.amount"
              },
              {
                "label": "Stage",
                "value": "=row.stage",
                "display": "chip"
              },
              {
                "label": "Closes",
                "value": "=row.closes"
              }
            ],
            "onRowClick": [
              {
                "go": {
                  "screen": "deal",
                  "params": {
                    "id": "=row.id"
                  }
                }
              }
            ]
          }
        ]
      },
      "lead": {
        "params": {
          "id": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          }
        },
        "data": {
          "pipeline": {
            "record": "crm_contacts",
            "id": "=params.id"
          },
          "person": {
            "record": "contacts",
            "id": "=params.contact"
          }
        },
        "content": [
          {
            "type": "text",
            "value": "The contact",
            "size": "title"
          },
          {
            "type": "form",
            "record": "=data.person",
            "fields": [
              "name",
              "email",
              "phone",
              "organisation",
              "role"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Save contact",
                "do": [
                  {
                    "update": {
                      "record": "=data.person",
                      "set": "=form.values"
                    }
                  },
                  {
                    "notify": "=\"Saved \" + form.name"
                  }
                ],
                "emphasis": "primary"
              }
            ]
          },
          {
            "type": "text",
            "value": "In the pipeline",
            "size": "title"
          },
          {
            "type": "form",
            "record": "=data.pipeline",
            "fields": [
              "stage",
              "source",
              "value",
              "next_step",
              "next_step_date"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Save pipeline",
                "do": [
                  {
                    "update": {
                      "record": "=data.pipeline",
                      "set": "=form.values"
                    }
                  },
                  {
                    "notify": "Saved."
                  }
                ],
                "emphasis": "primary"
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "pipeline"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "new_contact": {
        "content": [
          {
            "type": "form",
            "table": "contacts",
            "fields": [
              "name",
              "email",
              "phone",
              "mobile",
              "role",
              "tags",
              "owner"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Add",
                "do": [
                  {
                    "create": {
                      "table": "contacts",
                      "values": "=form.values"
                    }
                  },
                  {
                    "notify": "=\"Added \" + form.name"
                  },
                  {
                    "go": {
                      "screen": "contacts"
                    }
                  }
                ],
                "emphasis": "primary"
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "contacts"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "deals": {
        "data": {
          "open": {
            "from": "deals",
            "sort": "stage"
          },
          "byStage": {
            "from": "deals",
            "groupBy": "stage",
            "sum": "amount"
          }
        },
        "content": [
          {
            "type": "row",
            "content": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "New deal",
                "do": [
                  {
                    "go": {
                      "screen": "new_deal"
                    }
                  }
                ],
                "emphasis": "primary"
              }
            ]
          },
          {
            "type": "chart",
            "kind": "bar",
            "label": "Deals by stage",
            "rows": "=data.byStage",
            "measure": "total"
          },
          {
            "type": "table",
            "rows": "=data.open",
            "columns": [
              {
                "label": "Deal",
                "value": "=row.title"
              },
              {
                "label": "Contact",
                "value": "=row.contact"
              },
              {
                "label": "Organisation",
                "value": "=row.organisation"
              },
              {
                "label": "Amount",
                "value": "=row.amount"
              },
              {
                "label": "Stage",
                "value": "=row.stage",
                "display": "chip"
              },
              {
                "label": "Closes",
                "value": "=row.closes"
              }
            ],
            "onRowClick": [
              {
                "go": {
                  "screen": "deal",
                  "params": {
                    "id": "=row.id"
                  }
                }
              }
            ]
          }
        ]
      },
      "deal": {
        "params": {
          "id": {
            "type": "string"
          }
        },
        "data": {
          "deal": {
            "record": "deals",
            "id": "=params.id"
          }
        },
        "content": [
          {
            "type": "form",
            "record": "=data.deal",
            "fields": [
              "title",
              "contact",
              "organisation",
              "amount",
              "stage",
              "closes",
              "owner"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Save",
                "do": [
                  {
                    "update": {
                      "record": "=data.deal",
                      "set": "=form.values"
                    }
                  },
                  {
                    "notify": "Saved."
                  },
                  {
                    "go": {
                      "screen": "deals"
                    }
                  }
                ],
                "emphasis": "primary"
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "deals"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "new_deal": {
        "content": [
          {
            "type": "form",
            "table": "deals",
            "fields": [
              "title",
              "amount",
              "stage",
              "closes",
              "owner"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Add",
                "do": [
                  {
                    "create": {
                      "table": "deals",
                      "values": "=form.values"
                    }
                  },
                  {
                    "notify": "=\"Added \" + form.title"
                  },
                  {
                    "go": {
                      "screen": "deals"
                    }
                  }
                ],
                "emphasis": "primary"
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "deals"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "sample": {
    "contacts": [
      {
        "name": "Ana Ruiz",
        "email": "ana@example.com",
        "role": "Owner"
      },
      {
        "name": "Ben Okafor",
        "email": "ben@example.com",
        "role": "Buyer"
      }
    ],
    "deals": [
      {
        "title": "Website refresh",
        "amount": 480000,
        "stage": "Proposal",
        "closes": "2026-12-15"
      },
      {
        "title": "Support plan",
        "amount": 120000,
        "stage": "Won"
      }
    ]
  }
}
