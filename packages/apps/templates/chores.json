{
  "key": "chores",
  "name": "Chores and points",
  "icon": "star",
  "glyph": "cleaningServices",
  "color": "#0B7A5B",
  "audiences": [
    "family"
  ],
  "description": "Chores on a board for each child; a grown-up approves what's done, and the points add up.",
  "tables": [
    {
      "key": "chores",
      "fields": [
        {
          "key": "task",
          "type": "text",
          "required": true
        },
        {
          "key": "who",
          "type": "text",
          "required": true
        },
        {
          "key": "points",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 100
        },
        {
          "key": "due",
          "type": "date"
        },
        {
          "key": "status",
          "type": "choice",
          "choices": [
            "To do",
            "Done",
            "Approved"
          ]
        },
        {
          "key": "repeat",
          "type": "choice",
          "choices": [
            "Once",
            "Every day",
            "Every week"
          ]
        },
        {
          "key": "notes",
          "type": "text"
        }
      ]
    }
  ],
  "definition": {
    "home": "board",
    "navigation": {
      "style": "tabs",
      "items": [
        {
          "screen": "board",
          "label": "Board",
          "icon": "check"
        },
        {
          "screen": "points",
          "label": "Points",
          "icon": "star"
        },
        {
          "screen": "chores",
          "label": "All chores",
          "icon": "search"
        }
      ]
    },
    "screens": {
      "board": {
        "data": {
          "open": {
            "from": "chores",
            "where": "=status != \"Approved\" || due >= addDays(today(), -7)",
            "sort": "due"
          }
        },
        "content": [
          {
            "type": "row",
            "content": [
              {
                "type": "text",
                "value": "Move a chore to Done when it's done. A grown-up moves it to Approved.",
                "size": "body"
              },
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "New chore",
                "emphasis": "primary",
                "icon": "add",
                "do": [
                  {
                    "go": {
                      "screen": "new_chore"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "board",
            "rows": "=data.open",
            "groupBy": "status",
            "title": "=row.task",
            "subtitle": "=row.who + \" · \" + string(int(row.points)) + \" points\"",
            "onClick": [
              {
                "go": {
                  "screen": "chore",
                  "params": {
                    "id": "=row.id"
                  }
                }
              }
            ]
          }
        ]
      },
      "points": {
        "data": {
          "week": {
            "from": "chores",
            "where": "=status == \"Approved\" && due >= startOfWeek(today())",
            "groupBy": "who",
            "sum": "points"
          },
          "ever": {
            "from": "chores",
            "where": "=status == \"Approved\"",
            "groupBy": "who",
            "sum": "points"
          }
        },
        "content": [
          {
            "type": "chart",
            "kind": "bar",
            "label": "Points this week",
            "rows": "=data.week",
            "measure": "total"
          },
          {
            "type": "totals",
            "label": "Points this week",
            "rows": "=data.week"
          },
          {
            "type": "totals",
            "label": "All-time points",
            "rows": "=data.ever"
          }
        ]
      },
      "chores": {
        "data": {
          "all": {
            "from": "chores",
            "sort": "due"
          }
        },
        "content": [
          {
            "type": "row",
            "content": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "New chore",
                "emphasis": "primary",
                "icon": "add",
                "do": [
                  {
                    "go": {
                      "screen": "new_chore"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "table",
            "rows": "=data.all",
            "columns": [
              {
                "label": "Chore",
                "value": "=row.task"
              },
              {
                "label": "Who",
                "value": "=row.who"
              },
              {
                "label": "Points",
                "value": "=row.points"
              },
              {
                "label": "Due",
                "value": "=row.due"
              },
              {
                "label": "Status",
                "value": "=row.status",
                "display": "chip"
              },
              {
                "label": "Repeats",
                "value": "=row.repeat"
              }
            ],
            "search": "Find a chore",
            "onRowClick": [
              {
                "go": {
                  "screen": "chore",
                  "params": {
                    "id": "=row.id"
                  }
                }
              }
            ]
          }
        ]
      },
      "chore": {
        "params": {
          "id": {
            "type": "string"
          }
        },
        "data": {
          "item": {
            "record": "chores",
            "id": "=params.id"
          }
        },
        "content": [
          {
            "type": "form",
            "record": "=data.item",
            "fields": [
              "task",
              "who",
              "points",
              "due",
              "repeat",
              "status",
              "notes"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Save",
                "emphasis": "primary",
                "icon": "save",
                "disabled": "=!form.valid || !form.changed",
                "do": [
                  {
                    "update": {
                      "record": "=data.item",
                      "set": "=form.values"
                    }
                  },
                  {
                    "notify": "=\"Saved.\""
                  },
                  {
                    "go": {
                      "screen": "chores"
                    }
                  }
                ]
              },
              {
                "type": "button",
                "label": "Approve",
                "icon": "check",
                "showIf": "=data.item.status == \"Done\"",
                "do": [
                  {
                    "update": {
                      "record": "=data.item",
                      "set": {
                        "status": "Approved"
                      }
                    }
                  },
                  {
                    "notify": "=\"Approved: the points count.\""
                  }
                ]
              },
              {
                "type": "button",
                "label": "Do it again",
                "icon": "add",
                "showIf": "=data.item.repeat != \"Once\" && data.item.repeat != \"\"",
                "do": [
                  {
                    "create": {
                      "table": "chores",
                      "values": {
                        "task": "=data.item.task",
                        "who": "=data.item.who",
                        "points": "=data.item.points",
                        "repeat": "=data.item.repeat",
                        "status": "To do",
                        "due": "=data.item.repeat == \"Every week\" ? addDays(today(), 7) : addDays(today(), 1)"
                      }
                    }
                  },
                  {
                    "notify": "=\"Added again.\""
                  }
                ]
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "chores"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "row",
            "content": [
              {
                "type": "spacer"
              },
              {
                "type": "button",
                "label": "Remove",
                "icon": "close",
                "emphasis": "subtle",
                "confirm": "Remove this chore? It can be brought back from the Data tab.",
                "do": [
                  {
                    "markObsolete": {
                      "record": "=data.item"
                    }
                  },
                  {
                    "notify": "=\"Removed.\""
                  },
                  {
                    "go": {
                      "screen": "chores"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "new_chore": {
        "content": [
          {
            "type": "form",
            "table": "chores",
            "fields": [
              "task",
              "who",
              "points",
              "due",
              "repeat",
              "notes"
            ],
            "buttons": [
              {
                "type": "button",
                "label": "Add",
                "emphasis": "primary",
                "icon": "add",
                "disabled": "=!form.valid",
                "do": [
                  {
                    "create": {
                      "table": "chores",
                      "values": "=form.values",
                      "preset": {
                        "status": "To do"
                      }
                    }
                  },
                  {
                    "notify": "=\"Added.\""
                  },
                  {
                    "go": {
                      "screen": "board"
                    }
                  }
                ]
              },
              {
                "type": "button",
                "label": "Back",
                "do": [
                  {
                    "go": {
                      "screen": "chores"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "sample": {
    "chores": [
      {
        "task": "Feed the cat",
        "who": "Maya",
        "points": 2,
        "due": "2026-11-28",
        "status": "To do",
        "repeat": "Every day"
      },
      {
        "task": "Tidy your room",
        "who": "Theo",
        "points": 5,
        "due": "2026-11-29",
        "status": "Done",
        "repeat": "Every week"
      },
      {
        "task": "Help wash the car",
        "who": "Maya",
        "points": 10,
        "due": "2026-11-25",
        "status": "Approved",
        "repeat": "Once"
      }
    ]
  }
}
